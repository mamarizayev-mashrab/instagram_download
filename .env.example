# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Instagram credentials — USE A SECONDARY / BURNER ACCOUNT, NOT YOUR MAIN ONE.
# Needed only for stories, highlights, HD profile pictures and private-ish content.
IG_USERNAME=your_secondary_instagram_username
IG_PASSWORD=your_instagram_password

# Optional: max upload size in MB (Telegram Bot API limit is 50 unless you run a local Bot API server)
MAX_UPLOAD_MB=50

# Optional: cap simultaneous downloads so a burst can't exhaust free-tier RAM/CPU.
MAX_CONCURRENT_DOWNLOADS=2

# Optional (webhook mode): secret validating incoming updates. A strong random
# value is generated automatically if left unset.
# WEBHOOK_SECRET=

# --- YouTube (only needed when YouTube blocks the server with a bot check) ---
# Path to a Netscape cookies.txt exported from a logged-in (burner) YouTube
# account. On Render, upload it as a Secret File and point here.
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt
# Optional: comma-separated yt-dlp player clients to try (usually leave unset).
# YOUTUBE_PLAYER_CLIENT=

# --- 2 GB uploads via a self-hosted Bot API server (see docker-compose.yml) ---
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# TELEGRAM_API_ID=your_api_id          # from https://my.telegram.org
# TELEGRAM_API_HASH=your_api_hash
