# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Instagram credentials — USE A SECONDARY / BURNER ACCOUNT, NOT YOUR MAIN ONE.
# Needed only for stories, highlights, HD profile pictures and private-ish content.
IG_USERNAME=your_secondary_instagram_username
IG_PASSWORD=your_instagram_password

# Optional: max upload size in MB (Telegram Bot API limit is 50 unless you run a local Bot API server)
MAX_UPLOAD_MB=50
